# DeepSeek API
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash

# Zhihu API
ZHIHU_ACCESS_SECRET=

# Retrieval budgets (optional)
RETRIEVAL_TIME_BUDGET=180
RETRIEVAL_TOKEN_BUDGET=100000

# Path planner budgets, separate from retrieval (optional)
PATH_CANDIDATE_TOKEN_BUDGET=80000
PATH_PLAN_TOKEN_BUDGET=80000
PATH_REVISION_TOKEN_BUDGET=80000

# Companion budgets per message, separate from path/retrieval
COMPANION_TOKEN_BUDGET=80000
COMPANION_TIME_BUDGET=60

# Web search tool (optional; keep empty to use normal chat without web access)
TAVILY_API_KEY=
COMPANION_WEB_TOKEN_BUDGET=100000
COMPANION_WEB_TIME_BUDGET=90
WEB_SEARCH_TIME_BUDGET=40
WEB_EVIDENCE_TOKEN_BUDGET=10000
WEB_CONTEXT_TOKEN_BUDGET=18000
WEB_SEARCH_CACHE_SECONDS=1800

# Journey review, independent of search and companion budgets
EXPERIENCE_TOKEN_BUDGET=80000
EXPERIENCE_TIME_BUDGET=180
